# Copy relevant values to backend/.env and frontend/.env.local

DATABASE_URL=postgres://trc:trc@localhost:5432/columbiatrc
PORT=4000
FRONTEND_URL=http://localhost:3000

AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://columbiatrc-api
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_ROLE_CLAIM=https://columbiatrc.example.com/roles
AUTH0_SECRET=replace-with-a-long-random-string

AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_STORAGE_CONTAINER=trc-records
